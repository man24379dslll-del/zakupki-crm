# --- База данных (Supabase → Project Settings → Database → Connection string → Session pooler) ---
DATABASE_URL=postgresql://postgres.<project-ref>:<пароль>@aws-0-<регион>.pooler.supabase.com:5432/postgres
# true — принудительно включить SSL (для supabase определяется автоматически)
DATABASE_SSL=
DATABASE_POOL_MAX=10

# --- Хранилище документов: Supabase Storage (Project Settings → API) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role ключ — только на сервере, никому не передавать>
SUPABASE_BUCKET=documents
# без SUPABASE_* файлы пишутся в локальную папку (только для разработки)
UPLOAD_DIR=./storage/uploads

# --- Первый вход руководителя (создаётся при первом запуске, если такого логина нет) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=<надёжный пароль>

# --- Прочее ---
COOKIE_SECURE=true
TZ=Europe/Moscow
TZ_COMPANY=Europe/Moscow
